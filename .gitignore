# dependencies
node_modules/
.pnp
.pnp.js

# build
dist/
build/
.vite/

# env / secrets — API 키는 절대 커밋하지 않는다
.env
.env.*
!.env.example
.dev.vars

# cloudflare workers
.wrangler/

# test / coverage
coverage/
*.tsbuildinfo

# editor / os
.DS_Store
.idea/
.vscode/
*.swp

# claude code local settings
.claude/settings.local.json

# 에이전트 실행 중간 산출물(원장·리뷰 패키지). 결과는 커밋과 docs/에만 남긴다.
.superpowers/

# 개인 작업 공간 — 확인 질문지, 메모, 임시 스크립트
local/

# 도구가 뱉은 산출물(lighthouse 리포트, 포트폴리오 슬라이드, 스크린샷).
# 상위 폴더 규칙(~/Project/CLAUDE.md)이 만드는 자리인데 이 리포에는 이미 제 자리가 있다 —
# 문서는 docs/, 빌드 결과는 CI가 만드는 dist/다. 다시 만들 수 있는 것을 리포에 싣지 않는다.
output/

# 일러스트 원본. 화면에서 100px로 그리는 그림을 1792×2400으로 리포에 실어 나르지 않는다.
# 쓰는 것은 src/assets/에 들어간 340px WebP 사본이고, 원본은 각자 로컬에만 둔다.
docs/image/

# 데모 영상 원본(.mov 800MB대). GitHub는 100MB 초과 파일을 거부하고,
# 한번 이력에 들어가면 지우기 어렵다. 편집 결과물 mp4만 커밋한다.
# 경로 없는 앵커(video/*.mov)는 루트 기준이라 docs/video/를 못 막는다.
**/*.mov
**/*.MOV
